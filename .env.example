# Firebase web app config — Match Calendar app in the shared MatchReadyTX project.
# Firebase Console → Project settings → Your apps → Match Calendar (second web app).
# Use the same projectId/apiKey as MatchReadyTX; appId is unique per web app.
#
# Copy to .env.local for local dev (`npm run dev`).
# Production builds use GitHub Actions secrets — see .github/workflows/deploy.yml.
# After deploy, add matchcalendar.web.app to Authentication → Authorized domains.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Platform operator tabs on Profile (Members + aggregated Insights).
# Must match MatchReadyTX function env MATCH_CALENDAR_PLATFORM_ADMIN_*.
VITE_PLATFORM_ADMIN_UIDS=
VITE_PLATFORM_ADMIN_EMAILS=
